{
  "name": "molpha-solana-program",
  "version": "0.1.0",
  "private": true,
  "description": "Molpha oracle program for Solana, with its operator CLI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Molpha/molpha-solana-program.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "molpha": "cli/dist/index.js"
  },
  "scripts": {
    "lint": "prettier --check \"cli/**/*.{js,ts}\" \"scripts/**/*.{js,mjs,ts}\"",
    "lint:fix": "prettier --write \"cli/**/*.{js,ts}\" \"scripts/**/*.{js,mjs,ts}\"",
    "build:molpha": "anchor build -p molpha",
    "build:cli": "tsc -p cli/tsconfig.json",
    "build": "yarn build:cli && yarn build:molpha",
    "test": "anchor build -p molpha && cargo test --workspace",
    "test:cli": "yarn build:cli && node --test cli/tests/*.cjs",
    "molpha": "node cli/dist/index.js",
    "generate-nodes": "node scripts/generate-nodes.js",
    "register-nodes": "node scripts/register-nodes.js",
    "update-node-endpoints": "node scripts/update-node-endpoints.js"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@noble/hashes": "^2.4.0",
    "@noble/secp256k1": "^3.2.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^22.15.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
